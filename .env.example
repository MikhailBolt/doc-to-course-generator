DOCS_PATH=docs
# When true, directory mode also scans subfolders for .pdf/.txt/.md (see README)
DOCS_RECURSIVE=false

DB_FAISS_PATH=vectorstore/db_faiss
MANIFEST_FILE=vectorstore/index_manifest.json
OUTPUT_DIR=output
LOG_DIR=logs

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=llama3

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=6
QUIZ_QUESTIONS=10
PRETEST_QUESTIONS=5
DIFFICULTY=medium
RETRIEVAL_TYPE=similarity
LANGUAGE=en
MAX_PREVIEW_CHARS_PER_FILE=6000
OUTPUT_PREFIX=
MIN_LESSONS=4
MAX_LESSONS=7

# Optional: outline uses FAISS retrieval for grounding (defaults work for most docs).
OUTLINE_RAG_MAX_CHUNKS=28
OUTLINE_RAG_MAX_CHARS=12000

# Optional: custom Ollama host (default http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Optional exports (also available as CLI flags / Streamlit checkboxes)
# EXPORT_DOCX=false
# EXPORT_PDF=false
